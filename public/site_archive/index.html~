<script>
(function() {
  function extractVideoId(url) {
    try {
      if (url.includes('youtube.com/watch')) return new URL(url).searchParams.get('v');
      if (url.includes('youtu.be/')) return url.split('youtu.be/')[1].split('?')[0];
      if (url.includes('youtube.com/embed/')) return url.split('youtube.com/embed/')[1].split('?')[0];
    } catch(e) {}
    return null;
  }

  function embedHtml(videoId) {
    return `<div class="embed-container"><iframe src="https://www.youtube.com/embed/${videoId}" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>`;
  }

  window.indexCarouselNav = function(id, dir) {
    const carousel = document.getElementById(id);
    if (!carousel) return;
    const slides = carousel.querySelectorAll('.yt-slide');
    let active = [...slides].findIndex(s => s.style.display !== 'none');
    if (active === -1) active = 0;
    slides[active].style.display = 'none';
    const next = (active + dir + slides.length) % slides.length;
    slides[next].style.display = 'block';
    const ind = carousel.querySelector('.yt-indicator');
    if (ind) ind.textContent = `${next + 1} / ${slides.length}`;
  };

  async function loadIndexFeatured() {
    const el = document.getElementById('index-featured-content');
    if (!el) return;
    try {
      const res = await fetch('/api/featured');
      if (!res.ok) throw new Error();
      const { data } = await res.json();
      const raw = data && (data.youtube || data.youtubeUrl);
      if (!raw) { el.innerHTML = ''; return; }
      const urls = (Array.isArray(raw) ? raw : raw.split(',').map(u => u.trim())).filter(Boolean);
      const ids = urls.map(extractVideoId).filter(Boolean);
      if (!ids.length) { el.innerHTML = ''; return; }

      if (ids.length === 1) {
        el.innerHTML = embedHtml(ids[0]);
      } else {
        const cid = 'idx-carousel-' + Math.random().toString(36).slice(2, 7);
        const slides = ids.map((id, i) =>
          `<div class="yt-slide" style="display:${i===0?'block':'none'}">${embedHtml(id)}</div>`
        ).join('');
        el.innerHTML = `<div id="${cid}" class="yt-carousel">
          ${slides}
          <div class="yt-controls">
            <button class="yt-prev" onclick="indexCarouselNav('${cid}',-1)">&laquo; PREV</button>
            <span class="yt-indicator">1 / ${ids.length}</span>
            <button class="yt-next" onclick="indexCarouselNav('${cid}',1)">NEXT &raquo;</button>
          </div>
        </div>`;
      }
    } catch(e) {
      el.innerHTML = '';
    }
  }

  document.addEventListener('DOMContentLoaded', loadIndexFeatured);
})();
</script>

